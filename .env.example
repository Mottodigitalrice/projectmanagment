# Convex
# From: https://dashboard.convex.dev → your project → Settings
NEXT_PUBLIC_CONVEX_URL=https://glorious-cobra-228.convex.cloud                # "Deployment URL" from Convex dashboard
NEXT_PUBLIC_CONVEX_SITE_URL=https://glorious-cobra-228.convex.site           # "HTTP Actions URL" from Convex dashboard

# Clerk
# From: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=     # "Publishable Key" (starts with pk_)
CLERK_SECRET_KEY=                      # "Secret Key" (starts with sk_)

# These are pre-configured, don't change
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
